# Copie para .env e ajuste. O arquivo .env está no .gitignore.

# Chave gratuita do FRED, necessária apenas para as séries dos Estados Unidos
# (CPI, desemprego, payroll, Fed Funds, DXY).
# Obtenha em https://fred.stlouisfed.org/docs/api/api_key.html
#
# Mesmo nome nos três lugares: aqui, nos secrets do GitHub Actions e nos do
# Streamlit. É a única variável sem o prefixo TESOURARIA_, justamente para não
# haver dois nomes para a mesma chave.
FRED_API_KEY=

# Lê as amostras sintéticas de data/fixtures em vez da rede.
# Útil para desenvolver e para demonstrar o aplicativo sem conexão.
TESOURARIA_OFFLINE=0

# Ajustes de rede (opcionais).
TESOURARIA_HTTP_TIMEOUT=30
TESOURARIA_HTTP_CACHE_TTL_HOURS=6
